# Make a local .env from this file; never commit actual passwords or tokens.
# START_WINDOWS.bat automatically loads .env.
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Production: https://activate.startuptrading.com (see ACTIVATE_DOMAIN.md).
# Set true only after the custom domain works, to move visitors off the old
# *.onrender.com address. Webhooks, /health and /oauth/callback are never redirected.
CANONICAL_REDIRECT=false
DATABASE_PATH=data/startuptrading.db
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=
WHOP_API_KEY=
WHOP_API_VERSION=2026-11-17-3
WHOP_WEBHOOK_SECRET=
NT_USERNAME=
NT_PASSWORD=
NT_APP_ID=StartUpTradeLicensing
NT_APP_VERSION=1.0
NT_CID=
NT_SEC=
LICENSE_WRITES_ENABLED=false
ALLOWED_TEST_EMAIL=
ALLOWED_TEST_MEMBERSHIP=
NINJATRADER_REFERRAL_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
LOCAL_DEMO_OTP=false
RUN_RECONCILER=false
RECONCILE_INTERVAL_SECONDS=900

# Admin-only UX preview requires explicit Whop user allowlist; does NOT bypass customer eligibility or create licenses.
ADMIN_TEST_ENABLED=false
ADMIN_TEST_WHOP_USER_ID=
# Alternative: your exact Whop-login email, but Whop userinfo MUST report email_verified=true.
ADMIN_TEST_WHOP_EMAIL=

# Hosted database: set DATABASE_URL to a persistent PostgreSQL connection URL.
# Set REQUIRE_PERSISTENT_DB=true on Render. Do not enable production operation
# using Render's ephemeral SQLite filesystem.
DATABASE_URL=
REQUIRE_PERSISTENT_DB=false

# HTTPS email sending: create a Resend API key and verify your sending domain.
# If provided, this takes precedence over SMTP.
RESEND_API_KEY=
RESEND_FROM=

# Customer-facing links shown on the activation pages and emails (hidden when blank).
SUPPORT_EMAIL=
DISCORD_URL=
# HTTPS page explaining how to install the indicators in NinjaTrader. Activation
# emails are not sent until this is set.
INDICATOR_SETUP_URL=
# Whop checkout link for non-members (e.g. shown when no membership is found).
CHECKOUT_URL=
# Where members manage their Whop membership (renewals, billing).
WHOP_HUB_URL=
