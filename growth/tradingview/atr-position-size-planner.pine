// This Pine Script code is subject to the terms of the Mozilla Public License 2.0
// at https://mozilla.org/MPL/2.0/
// (c) {TradingView username}
// Risk first. Stop second. Size last.
//@version=6
indicator("Futures Position Size Calculator - ATR & Prop Firm Risk",
     shorttitle = "Futures Risk", overlay = true,
     max_lines_count = 20, max_labels_count = 20, max_boxes_count = 10)

// ===== Design system: identical in every tool of this series =====
TOOL_NAME    = "FUTURES RISK PLANNER"
TOOL_VERSION = "v1.2"
MOTTO        = "Risk first | stop second | size last"
C_PANEL      = color.new(#0b0e13, 4)
C_HEADER     = color.new(#fa7b39, 0)
C_HEADER_TXT = color.new(#170b03, 0)
C_SUB        = color.new(#161c26, 0)
C_LINE       = color.new(#2a3240, 0)
C_LABEL      = color.new(#9aa4b2, 0)
C_VALUE      = color.new(#e8edf3, 0)
C_GOOD       = color.new(#3ddc97, 0)
C_WARN       = color.new(#ffb454, 0)
C_BAD        = color.new(#ff6b5b, 0)
C_MUTED      = color.new(#6b7689, 0)
EPS          = 1e-9

// ===== Inputs =====
G_RISK = "Risk budget"
riskMode  = input.string("Fixed $", "Risk mode",
     options = ["Fixed $", "% of account", "Prop firm"], group = G_RISK)
riskUsd   = input.float(250.0, "Risk per trade", minval = 1, group = G_RISK,
     tooltip = "Fixed $ mode. In the chart symbol's currency.")
acctSize  = input.float(50000.0, "Account size", minval = 1, group = G_RISK,
     tooltip = "% of account mode.")
riskPct   = input.float(0.5, "Risk per trade (%)", minval = 0.01, step = 0.05, group = G_RISK)
useDaily  = input.bool(false, "Apply a daily loss constraint", group = G_RISK,
     tooltip = "On: an allowance of 0 means the day's limit is used up, so the budget is 0.")
dailyLeft = input.float(0.0, "Remaining daily loss allowance", minval = 0, group = G_RISK,
     tooltip = "What is left of today's loss limit. Daily cap per trade = remaining " +
     "allowance x (1 - safety buffer, Prop firm mode only) / planned daily losses. " +
     "The risk budget is the smaller of this cap and the mode's budget.")
dailyLosses = input.int(2, "Planned daily losses", minval = 1, group = G_RISK,
     tooltip = "How many full losing trades today's remaining allowance must cover.")

G_PROP = "Prop firm planning"
ddType    = input.string("Trailing", "Drawdown rule", options = ["Trailing", "Static"],
     group = G_PROP, tooltip = "Firms define drawdown differently. A trailing limit moves " +
     "up with your peak balance; a static one does not. Read the current remaining " +
     "allowance from your firm's dashboard and enter it below.")
ddOriginal = input.float(2500.0, "Original max drawdown", minval = 1, group = G_PROP)
ddLeft    = input.float(2500.0, "Remaining drawdown allowance", minval = 0, group = G_PROP)
streak    = input.int(10, "Losing streak to survive", minval = 1, group = G_PROP,
     tooltip = "Risk per trade = remaining allowance (after buffer) / this number.")
bufferPct = input.float(10.0, "Safety buffer (%)", minval = 0, maxval = 90, step = 5,
     group = G_PROP, tooltip = "Keeps this share of each allowance untouched.")

G_STOP = "Stop"
atrLen    = input.int(14, "ATR length", minval = 1, group = G_STOP)
stopMult  = input.float(1.5, "Stop distance (x ATR)", minval = 0.1, step = 0.1, group = G_STOP)
atrTf     = input.timeframe("", "ATR timeframe (blank = chart)", group = G_STOP,
     tooltip = "Same or higher than the chart, e.g. 5-minute ATR on a 1-minute chart.")
closedBar = input.bool(false, "Use the last closed bar's ATR", group = G_STOP,
     tooltip = "On: numbers stay fixed while the bar forms. Off: ATR updates live.")

G_CONTRACT = "Contract"
pvInput   = input.float(0.0, "Value per point (0 = use the symbol's)", minval = 0,
     group = G_CONTRACT, tooltip = "ES 50, MES 5, NQ 20, MNQ 2, YM 5, RTY 50, CL 1000, GC 100")
costStd   = input.float(0.0, "Round-turn costs: standard / other contract", minval = 0,
     step = 0.1, group = G_CONTRACT, tooltip = "Commissions and fees per contract.")
costMicro = input.float(0.0, "Round-turn costs: micro contract", minval = 0, step = 0.1,
     group = G_CONTRACT)
showPair  = input.bool(true, "Compare standard vs micro", group = G_CONTRACT,
     tooltip = "ES/MES, NQ/MNQ, YM/MYM, RTY/M2K, CL/MCL, GC/MGC, SI/SIL, 6E/M6E, BTC/MBT.")

G_PLAN = "Trade plan (planning levels only: no orders are placed)"
side      = input.string("Both", "Plan for", options = ["Both", "Long", "Short"],
     group = G_PLAN)
entryIn   = input.price(0.0, "Planned entry (0 = last price)", group = G_PLAN)
targetR   = input.float(2.0, "Hypothetical target (R, 0 = off)", minval = 0, step = 0.5,
     group = G_PLAN)

G_VIEW = "Display"
txtSize   = input.string("Normal", "Panel text size", options = ["Small", "Normal", "Large"],
     group = G_VIEW)
panelSize = input.string("Full", "Panel", options = ["Full", "Compact"], group = G_VIEW)
tablePos  = input.string("Top right", "Panel position",
     options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = G_VIEW)
levelMode = input.string("Prices + risk", "Chart levels",
     options = ["Off", "Clean", "Prices", "Prices + risk"], group = G_VIEW)
showZones = input.bool(true, "Shade risk and target zones (Long or Short)", group = G_VIEW)
lineWidth = input.int(1, "Level line width", minval = 1, maxval = 3, group = G_VIEW)
regimeLen = input.int(100, "Normal-volatility lookback (bars)", minval = 10, group = G_VIEW)

// ===== Contract specifications (CME Group; verify with your broker) =====
// root, value per point, tick size, paired contract
var string[] ROOTS = array.from("ES", "MES", "NQ", "MNQ", "YM", "MYM", "RTY", "M2K",
     "CL", "MCL", "GC", "MGC", "SI", "SIL", "6E", "M6E", "BTC", "MBT")
var float[] PVS = array.from(50.0, 5.0, 20.0, 2.0, 5.0, 0.5, 50.0, 5.0,
     1000.0, 100.0, 100.0, 10.0, 5000.0, 1000.0, 125000.0, 12500.0, 5.0, 0.1)
var float[] TICKS = array.from(0.25, 0.25, 0.25, 0.25, 1.0, 1.0, 0.1, 0.1,
     0.01, 0.01, 0.1, 0.1, 0.005, 0.005, 0.00005, 0.0001, 5.0, 5.0)
var string[] PAIRS = array.from("MES", "ES", "MNQ", "NQ", "MYM", "YM", "M2K", "RTY",
     "MCL", "CL", "MGC", "GC", "SIL", "SI", "M6E", "6E", "MBT", "BTC")
var string[] MICROS = array.from("MES", "MNQ", "MYM", "M2K", "MCL", "MGC", "SIL", "M6E", "MBT")

// ===== Math (core rule unchanged: ticks rounded UP, contracts rounded DOWN) =====
atrPair(int off) =>
    a = ta.atr(atrLen)
    [a[off], ta.sma(a, regimeLen)[off]]

tfUse = atrTf == "" ? timeframe.period : atrTf
[atr, atrNormal] = request.security(syminfo.tickerid, tfUse, atrPair(closedBar ? 1 : 0),
     lookahead = closedBar ? barmerge.lookahead_on : barmerge.lookahead_off)
tfTooLow = timeframe.in_seconds(tfUse) < timeframe.in_seconds(timeframe.period)

// Stop in whole ticks, rounded up; the epsilon stops 6.0000000001 / 0.25 becoming 25 ticks.
ticksFor(float raw, float tk) =>
    tk > 0 and raw > 0 ? math.ceil(raw / tk - EPS) : 0
// Contracts rounded down; the epsilon stops 499.99999 / 250 becoming 1 instead of 2.
sizeFor(float budget, float per) =>
    per > 0 and budget > 0 ? math.floor(budget / per + EPS) : 0

pctBudget = acctSize * riskPct / 100
buffer    = 1 - bufferPct / 100
propBudget = ddLeft * buffer / streak
baseBudget = switch riskMode
    "% of account" => pctBudget
    "Prop firm"    => propBudget
    => riskUsd
// Daily cap: remaining allowance, less the buffer in Prop firm mode, spread over the
// planned daily losses. When the constraint is on, 0 left means a 0 budget (no trade).
dailyCap   = useDaily ? dailyLeft * (riskMode == "Prop firm" ? buffer : 1) / dailyLosses : na
riskBudget = na(dailyCap) ? baseBudget : math.min(baseBudget, dailyCap)

rawStop    = atr * stopMult
pointValue = pvInput > 0 ? pvInput : syminfo.pointvalue
tick       = syminfo.mintick
myIdx      = array.indexof(ROOTS, syminfo.root)
isMicro    = array.includes(MICROS, syminfo.root)
myCost     = myIdx >= 0 and isMicro ? costMicro : costStd

stopTicks   = ticksFor(rawStop, tick)
stopPts     = stopTicks * tick
perContract = stopPts * pointValue + myCost
contracts   = sizeFor(riskBudget, perContract)
estRisk     = contracts * perContract
remaining   = riskBudget - estRisk
utilization = riskBudget > 0 ? estRisk / riskBudget * 100 : na

dataOk = not na(atr) and atr > 0 and not na(pointValue) and pointValue > 0 and tick > 0

// Standard-versus-micro comparison, each with its own tick size and point value.
pairName  = myIdx >= 0 ? array.get(PAIRS, myIdx) : ""
pairIdx   = pairName != "" ? array.indexof(ROOTS, pairName) : -1
stdRoot   = isMicro ? pairName : syminfo.root
microRoot = isMicro ? syminfo.root : pairName

pairRow(string root) =>
    i   = array.indexof(ROOTS, root)
    pv  = i >= 0 ? array.get(PVS, i) : na
    tk  = i >= 0 ? array.get(TICKS, i) : na
    c   = array.includes(MICROS, root) ? costMicro : costStd
    tks = ticksFor(rawStop, tk)
    per = tks * tk * pv + c
    n   = sizeFor(riskBudget, per)
    [n, n * per, riskBudget - n * per, tks]

[stdN, stdRisk, stdLeft, stdTicks] = pairRow(stdRoot)
[mN, mRisk, mLeft, mTicks] = pairRow(microRoot)

regime      = atrNormal > 0 ? atr / atrNormal : na
regimeText  = na(regime) ? "warming up" :
     regime >= 1.25 ? "elevated" : regime <= 0.8 ? "quiet" : "normal"
regimeColor = na(regime) ? C_MUTED :
     regime >= 1.25 ? C_WARN : regime <= 0.8 ? C_MUTED : C_GOOD

entry       = entryIn > 0 ? entryIn : close
longStop    = entry - stopPts
shortStop   = entry + stopPts
longTarget  = targetR > 0 ? entry + stopPts * targetR : na
shortTarget = targetR > 0 ? entry - stopPts * targetR : na
// Hypothetical reward if the target is reached. Gross = price move only. Net = gross
// less the same round-turn costs that are included in the estimated stop risk.
grossReward = contracts * stopPts * pointValue * targetR
netReward   = grossReward - contracts * myCost

cur = syminfo.currency == "USD" ? "$" : syminfo.currency + " "
money(float v) =>
    na(v) ? "-" : (v < 0 ? "-" : "") + cur + str.tostring(math.abs(v), "#,##0.00")

// ===== Chart levels (planning levels only) =====
var line[] drawnLines = array.new_line()
var label[] drawnTags = array.new_label()
var box[] drawnBoxes  = array.new_box()

level(float price, color col, string name, string extra) =>
    lineStyle = name == "PLAN ENTRY" ? line.style_solid : line.style_dashed
    array.push(drawnLines, line.new(bar_index, price, bar_index + 1, price,
         extend = extend.right, color = col, style = lineStyle, width = lineWidth))
    if levelMode != "Clean"
        txt = name + "  " + str.tostring(price, format.mintick) +
             (levelMode == "Prices + risk" and extra != "" ? "  " + extra : "")
        array.push(drawnTags, label.new(bar_index + 4, price, txt,
             style = label.style_label_left, color = color.new(col, 82), textcolor = col,
             size = size.small))

zone(float a, float b, color col) =>
    array.push(drawnBoxes, box.new(bar_index, math.max(a, b), bar_index + 25,
         math.min(a, b), border_color = color.new(col, 100), bgcolor = color.new(col, 88)))

if barstate.islast
    for l in drawnLines
        line.delete(l)
    for t in drawnTags
        label.delete(t)
    for b in drawnBoxes
        box.delete(b)
    array.clear(drawnLines)
    array.clear(drawnTags)
    array.clear(drawnBoxes)
    if levelMode != "Off" and dataOk
        riskTxt = contracts > 0 ? "-" + money(estRisk) + " est." : ""
        rewTxt  = contracts > 0 ? "+" + money(netReward) + " net hypothetical" : ""
        level(entry, C_VALUE, "PLAN ENTRY", "")
        if side != "Short"
            level(longStop, C_BAD, "PLAN LONG STOP", riskTxt)
            if targetR > 0
                level(longTarget, C_GOOD, "PLAN LONG " + str.tostring(targetR) + "R", rewTxt)
        if side != "Long"
            level(shortStop, C_BAD, "PLAN SHORT STOP", riskTxt)
            if targetR > 0
                level(shortTarget, C_GOOD, "PLAN SHORT " + str.tostring(targetR) + "R", rewTxt)
        if showZones and side == "Long"
            zone(entry, longStop, C_BAD)
            if targetR > 0
                zone(entry, longTarget, C_GOOD)
        if showZones and side == "Short"
            zone(entry, shortStop, C_BAD)
            if targetR > 0
                zone(entry, shortTarget, C_GOOD)

// ===== Dashboard =====
pos = switch tablePos
    "Bottom right" => position.bottom_right
    "Top left"     => position.top_left
    "Bottom left"  => position.bottom_left
    => position.top_right
TS  = txtSize == "Small" ? size.small : txtSize == "Large" ? size.large : size.normal
TSs = txtSize == "Large" ? size.normal : size.small
TSh = txtSize == "Small" ? size.large : size.huge

var table panel = table.new(pos, 3, 26, bgcolor = C_PANEL, border_color = C_LINE,
     border_width = 1, frame_color = C_LINE, frame_width = 1)

cellL(int r, string t, color c) =>
    table.cell(panel, 0, r, t, text_color = c, text_size = TSs,
         text_halign = text.align_left, text_font_family = font.family_monospace)
// A label on the left and one value spanning the two right-hand columns.
row(int r, string label, string value, color valueColor) =>
    cellL(r, label, C_LABEL)
    table.cell(panel, 1, r, value, text_color = valueColor, text_size = TS,
         text_halign = text.align_right, text_font_family = font.family_monospace)
    table.merge_cells(panel, 1, r, 2, r)
// A full-width line.
wide(int r, string t, color fg, color bg, string sz) =>
    table.cell(panel, 0, r, t, text_color = fg, bgcolor = bg, text_size = sz,
         text_halign = text.align_left, text_font_family = font.family_monospace)
    table.merge_cells(panel, 0, r, 2, r)
// Three columns: label, standard, micro.
trio(int r, string label, string a, string b, color ca, color cb) =>
    cellL(r, label, C_LABEL)
    table.cell(panel, 1, r, a, text_color = ca, text_size = TS,
         text_halign = text.align_right, text_font_family = font.family_monospace)
    table.cell(panel, 2, r, b, text_color = cb, text_size = TS,
         text_halign = text.align_right, text_font_family = font.family_monospace)

if barstate.islast
    table.clear(panel, 0, 0, 2, 25)
    wide(0, TOOL_NAME + "  " + TOOL_VERSION, C_HEADER_TXT, C_HEADER, TSs)
    wide(1, syminfo.ticker + "  |  " + timeframe.period + "  |  " + riskMode,
         C_LABEL, C_SUB, TSs)
    r = 2
    if not dataOk
        msg = na(atr) or atr <= 0 ? "Waiting for ATR data" : "Set the value per point"
        wide(r, msg, C_WARN, C_PANEL, TS)
        r += 1
    else
        // The maximum position size is the dominant element.
        wide(r, "MAX POSITION", C_MUTED, C_PANEL, TSs)
        r += 1
        exhausted = riskBudget <= 0
        heroTxt = exhausted ? "Risk budget exhausted - no trade." :
             contracts > 0 ? str.tostring(contracts) + " " + syminfo.root :
             "0 " + syminfo.root + "  skip or size down"
        wide(r, heroTxt, contracts > 0 ? C_GOOD : C_BAD, C_PANEL, exhausted ? TS : TSh)
        r += 1
        row(r, "Risk budget", money(riskBudget), C_VALUE)
        r += 1
        row(r, "Estimated stop risk", money(estRisk), C_VALUE)
        r += 1
        row(r, "Budget remaining", money(remaining), C_VALUE)
        r += 1
        row(r, "Budget used", na(utilization) ? "-" : str.tostring(utilization, "0") + "%",
             utilization > 100 ? C_BAD : C_VALUE)
        r += 1
        if panelSize == "Full"
            atrLabel = "ATR(" + str.tostring(atrLen) + (atrTf == "" ? "" : ", " + atrTf) +
                 (closedBar ? ", closed" : "") + ")"
            row(r, atrLabel, str.tostring(atr, format.mintick), C_VALUE)
            r += 1
            row(r, "Volatility vs normal", na(regime) ? regimeText :
                 str.tostring(regime, "0.00") + "x " + regimeText, regimeColor)
            r += 1
            row(r, "Stop (" + str.tostring(stopMult) + "x ATR)",
                 str.tostring(stopPts, format.mintick) + " / " + str.tostring(stopTicks) +
                 " ticks", C_VALUE)
            r += 1
            row(r, "Per contract" + (myCost > 0 ? " incl. costs" : ""), money(perContract),
                 C_VALUE)
            r += 1
            if targetR > 0 and contracts > 0
                rLabel = "At " + str.tostring(targetR) + "R target (hypothetical)"
                if myCost > 0
                    row(r, rLabel + ", net", money(netReward), C_MUTED)
                    r += 1
                    row(r, "  gross / costs", money(grossReward) + " / " +
                         money(contracts * myCost), C_MUTED)
                    r += 1
                else
                    row(r, rLabel, money(grossReward) + " (no costs set)", C_MUTED)
                    r += 1
        if showPair and pairIdx >= 0
            wide(r, "SAME STOP, BOTH CONTRACTS", C_MUTED, C_SUB, TSs)
            r += 1
            trio(r, "", stdRoot, microRoot, C_LABEL, C_LABEL)
            r += 1
            trio(r, "Max contracts", str.tostring(stdN), str.tostring(mN),
                 stdN > 0 ? C_GOOD : C_BAD, mN > 0 ? C_GOOD : C_BAD)
            r += 1
            trio(r, "Est. stop risk", money(stdRisk), money(mRisk), C_VALUE, C_VALUE)
            r += 1
            trio(r, "Remaining", money(stdLeft), money(mLeft), C_VALUE, C_VALUE)
            r += 1
        if riskMode == "Prop firm"
            used = ddOriginal > 0 ? (1 - ddLeft / ddOriginal) * 100 : na
            row(r, ddType + " DD left", money(ddLeft) + " of " + money(ddOriginal), C_VALUE)
            r += 1
            row(r, "DD used / buffer", str.tostring(used, "0") + "% / " +
                 str.tostring(bufferPct, "0") + "%", used >= 75 ? C_WARN : C_VALUE)
            r += 1
        if useDaily and estRisk > 0
            row(r, "Full stops left today", str.tostring(sizeFor(dailyLeft, estRisk)), C_VALUE)
            r += 1
        if tfTooLow
            wide(r, "ATR timeframe is below the chart's", C_WARN, C_PANEL, TSs)
            r += 1
        if syminfo.currency != "USD"
            wide(r, "Amounts in " + syminfo.currency, C_WARN, C_PANEL, TSs)
            r += 1
        if riskMode == "Prop firm"
            wide(r, "Planning aid. Check your firm's own rules.", C_MUTED, C_PANEL, size.tiny)
            r += 1
    wide(r, MOTTO, C_MUTED, C_PANEL, size.tiny)

// ===== Alerts =====
alertcondition(contracts != contracts[1], "Position size changed",
     "ATR position size changed: {{ticker}}")
alertcondition(regime >= 1.25 and regime[1] < 1.25, "Volatility expanded",
     "ATR moved above 1.25x its normal on {{ticker}}: sizes are smaller now")
